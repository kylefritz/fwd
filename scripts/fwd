#!/bin/sh
# Opens the fwd window, starting the app if it isn't running.
# Lives inside fwd.app; ~/.local/bin/fwd (or Homebrew's bin) links here.

self="$0"
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
app=$(cd "$(dirname "$self")/../../.." && pwd)

case "${1:-}" in
  --version|-v)
    /usr/bin/plutil -extract CFBundleShortVersionString raw "$app/Contents/Info.plist"
    ;;
  --help|-h)
    cat <<USAGE
fwd: SSH port forwarding for the macOS menu bar

Usage:
  fwd             open the fwd window (starts the app if needed)
  fwd --version   print the installed version
  fwd --help      show this help

Ports are managed in the app, or by editing ~/.config/fwd/ports.yaml.
Log: ~/Library/Logs/fwd/fwd.log
USAGE
    ;;
  "")
    # By bundle identifier, so a copy that is already running comes to the
    # front even if it was started from another path (as after an upgrade).
    # Falls back to this copy when macOS doesn't know the identifier yet.
    /usr/bin/open -b io.github.kylefritz.fwd --args --show-window 2>/dev/null ||
      exec /usr/bin/open "$app" --args --show-window
    ;;
  *)
    echo "fwd: unknown argument '$1' (try fwd --help)" >&2
    exit 2
    ;;
esac
